FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl golang protobuf-compiler && rm -rf /var/lib/apt/lists/*
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.28

ENV GOPATH=/root/go
ENV GOBIN=/root/go/bin
ENV PATH=$PATH:/root/go:/root/go/bin
